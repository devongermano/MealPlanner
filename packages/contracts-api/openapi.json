                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The verified caller and their household memberships",
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "mealplan API",
    "description": "Accounts, households, and roles. Authorization lives here (ARCHITECTURE.md, \"one brain\"); the database RLS policies are a containment boundary, not business logic.",
    "version": "mealplan/v2",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase Auth access token (GoTrue). Sent as \"Authorization: Bearer <token>\"."
      }
    },
    "schemas": {
      "ReadyzResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True when every dependency below is healthy."
          },
          "database": {
            "type": "boolean",
            "description": "Database reachable (SELECT 1 succeeded)."
          },
          "authMode": {
            "type": "string",
            "enum": [
              "jwks",
              "shared-secret"
            ],
            "description": "How access tokens are verified. \"jwks\" is the production posture — this service holds no signing material."
          }
        },
        "required": [
          "ok",
          "database",
          "authMode"
        ]
      },
      "CreateHouseholdRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Household name.",
            "minLength": 1,
            "maxLength": 120,
            "example": "The Germanos"
          },
          "displayName": {
            "type": "string",
            "description": "The creator's own human-readable name in this household. Required because every member has one — a member list of UUIDs is not a member list.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Devon"
          },
          "personName": {
            "type": "string",
            "description": "Which person in the library the creator eats as. Omit if the creator plans but does not eat.",
            "example": "devon"
          }
        },
        "required": [
          "name",
          "displayName"
        ]
      },
      "HouseholdMemberView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable name. Always present."
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "auth.users id, or null when this member is a PLACEHOLDER — a real member with no account yet. Null here is the one flag that distinguishes the two kinds of member; a placeholder can never be a caller."
          },
          "personName": {
            "type": "string",
            "nullable": true,
            "description": "Library person key, or null if this member does not eat."
          },
          "inviteEmail": {
            "type": "string",
            "nullable": true,
            "description": "Invite intent for a placeholder. Always null once the member has an account."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "displayName",
          "role",
          "userId",
          "personName",
          "inviteEmail",
          "createdAt"
        ]
      },
      "HouseholdDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HouseholdMemberView"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "members",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the offending field.",
            "example": "name"
          },
          "message": {
            "type": "string",
            "description": "What is wrong with it."
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "forbidden",
              "not_found",
              "validation_failed",
              "conflict",
              "internal"
            ],
            "description": "Machine-readable code. Switch on this."
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary. Not a stable contract."
          },
          "details": {
            "description": "Per-field detail. Present on validation_failed; every failing field is reported, not just the first.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          },
          "requestId": {
            "type": "string",
            "description": "Correlates this response with the server log line. Quote it in bug reports.",
            "example": "3f1c0b5e-9a1f-4a1d-9a2f-6b0c9c8f0a11"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "HouseholdSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ],
            "description": "The CALLER's role here."
          },
          "displayName": {
            "type": "string",
            "description": "The CALLER's display name here."
          },
          "personName": {
            "type": "string",
            "nullable": true,
            "description": "The CALLER's library person key here."
          },
          "memberCount": {
            "type": "number",
            "description": "Members in this household, including placeholders and the caller."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "displayName",
          "personName",
          "memberCount",
          "createdAt"
        ]
      },
      "UpdateHouseholdRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "AddHouseholdMemberRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "This member's human-readable name.",
            "minLength": 1,
            "maxLength": 120,
            "example": "Alex"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "auth.users id, when the caller already knows it. Omit to create a placeholder member with no account."
          },
          "personName": {
            "type": "string",
            "description": "The library person this member eats as.",
            "example": "alex"
          },
          "inviteEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "description": "Where an invitation WOULD be sent once that flow exists. Stored as intent only: it is never checked against the account directory, so sending it reveals nothing about whether an account exists. Rejected on a member that already has an account."
          }
        },
        "required": [
          "displayName",
          "role"
        ]
      },
      "UpdateOwnMembershipRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "personName": {
            "type": "string",
            "nullable": true,
            "description": "The library person you eat as. Send null to stop eating in this plan.",
            "example": "devon"
          }
        }
      },
      "UpdateHouseholdMemberRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Placeholder members only — once a member has an account, their display name is theirs."
          },
          "personName": {
            "type": "string",
            "nullable": true,
            "description": "Accepted on ANY member, placeholder or not: the library link is planning data, and the planner runs the plan. Send null to unlink the member from it.",
            "example": "alex"
          },
          "inviteEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 320,
            "nullable": true,
            "description": "Placeholder members only. Send null to clear."
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "auth.users id of the verified caller."
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "isAnonymous": {
            "type": "boolean"
          },
          "households": {
            "description": "Every household the caller belongs to.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HouseholdSummary"
            }
          }
        },
        "required": [
          "userId",
          "email",
          "isAnonymous",
          "households"
        ]
      }
    }
  }
}

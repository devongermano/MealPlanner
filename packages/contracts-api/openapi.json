  "info": {
    "title": "mealplan API",
    "description": "Accounts, households, and roles. Authorization lives here (ARCHITECTURE.md, \"one brain\"); the database RLS policies are a containment boundary, not business logic.",
    "version": "mealplan/v2",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase Auth access token (GoTrue). Sent as \"Authorization: Bearer <token>\"."
      }
    },
    "schemas": {
      "ReadyzResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True when every dependency below is healthy."
          },
          "database": {
            "type": "boolean",
            "description": "Database reachable (SELECT 1 succeeded)."
          },
          "authMode": {
            "type": "string",
            "enum": [
              "jwks",
              "shared-secret"
            ],
            "description": "How access tokens are verified. \"jwks\" is the production posture — this service holds no signing material."
          }
        },
        "required": [
          "ok",
          "database",
          "authMode"
        ]
      },
      "CreateHouseholdRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name.",
            "minLength": 1,
            "maxLength": 120,
            "example": "The Germanos"
          },
          "personName": {
            "type": "string",
            "description": "Which person in the library the creator eats as. Omit if the creator plans but does not eat — the membership is still created, as a planner.",
            "example": "jimbo"
          }
        },
        "required": [
          "name"
        ]
      },
      "HouseholdMemberView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "auth.users id."
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "personName": {
            "type": "object",
            "nullable": true,
            "description": "Library person key, or null if this account does not eat."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "role",
          "personName",
          "createdAt"
        ]
      },
      "HouseholdDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HouseholdMemberView"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "members",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApiErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the offending field.",
            "example": "name"
          },
          "message": {
            "type": "string",
            "description": "What is wrong with it."
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "forbidden",
              "not_found",
              "validation_failed",
              "conflict",
              "internal"
            ],
            "description": "Machine-readable code. Switch on this."
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary. Not a stable contract."
          },
          "details": {
            "description": "Per-field detail. Present on validation_failed; every failing field is reported, not just the first.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          },
          "requestId": {
            "type": "string",
            "description": "Correlates this response with the server log line. Quote it in bug reports.",
            "example": "3f1c0b5e-9a1f-4a1d-9a2f-6b0c9c8f0a11"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "HouseholdSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ],
            "description": "The CALLER's role here."
          },
          "personName": {
            "type": "object",
            "nullable": true,
            "description": "The CALLER's library person key here."
          },
          "memberCount": {
            "type": "number",
            "description": "Members in this household, including the caller."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "personName",
          "memberCount",
          "createdAt"
        ]
      },
      "UpdateHouseholdRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "AddHouseholdMemberRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "auth.users id of the account to add. The caller must already know it — this API does not look accounts up by email, because a lookup endpoint tells an attacker which addresses have accounts. Email invitations are the intended replacement (see README open questions)."
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "personName": {
            "type": "string",
            "description": "The library person this account eats as.",
            "example": "alice"
          }
        },
        "required": [
          "userId",
          "role"
        ]
      },
      "UpdateHouseholdMemberRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "cook",
              "eater"
            ]
          },
          "personName": {
            "type": "object",
            "nullable": true,
            "description": "The library person this account eats as. Send null to unlink (the account keeps its membership but stops being an eater in the plan).",
            "example": "alice"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "auth.users id of the verified caller."
          },
          "email": {
            "type": "object",
            "nullable": true
          },
          "isAnonymous": {
            "type": "boolean"
          },
          "households": {
            "description": "Every household the caller belongs to.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HouseholdSummary"
            }
          }
        },
        "required": [
          "userId",
          "email",
          "isAnonymous",
          "households"
        ]
      }
    }
  }
}

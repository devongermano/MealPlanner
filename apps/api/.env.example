# Copy to apps/api/.env and adjust. Never commit .env (the repo .gitignore
# already covers it).
#
# The values below match a default `supabase start` from apps/api. The one you
# must paste yourself is SUPABASE_JWT_SECRET, which that command prints.

# --- Database -------------------------------------------------------------
# Local Supabase Postgres. Prisma connects as the schema owner, which is what
# exempts the API from the RLS policies (see the migration's section 3).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Auth: pick EXACTLY ONE verification mode -----------------------------
# Setting both is a boot error, on purpose: silently preferring one is how a
# service ends up verifying against a key nobody believes it is using.

# Mode A — shared secret (HS256). Zero setup: `supabase start` prints
# "JWT secret". Fine locally; it means this service holds signing material.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Mode B — asymmetric (ES256/RS256) via JWKS. PREFERRED, and what production
# should use: the API can verify tokens but cannot mint them. Enable
# signing_keys_path in supabase/config.toml first, then comment out
# SUPABASE_JWT_SECRET above and uncomment this.
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Required in both modes. An unverified issuer accepts tokens from any project
# that happens to share the algorithm.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1

# Optional, shown with their defaults.
# SUPABASE_JWT_AUDIENCE=authenticated
# AUTH_ALLOW_ANONYMOUS=false
# AUTH_CLOCK_TOLERANCE_SEC=5

# --- Server ---------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# SOLVER_URL=http://localhost:8000

# Serve Swagger UI on /docs. Local convenience; leave off in production.
# API_DOCS=1
